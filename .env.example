# Método G90 — Environment Variables Template
# Copy this file to .env or inject these variables into your hosting environment (Netlify, Vercel, etc.)

# Official WhatsApp Contact Number (Country code + area code + number without spaces or dashes)
WHATSAPP_NUMBER=5511999999999

# CRM Webhook Endpoint & API Authorization Key
CRM_ENDPOINT=https://api.metodog90.com.br/v1/leads
CRM_API_KEY=your_crm_api_key_here

# CTA Button Delay in milliseconds (Default: 180000 = 3 minutes)
CTA_DELAY_MS=180000
