# Método G90 — Environment Variables Template
# Copy this file to .env and fill in your actual production keys.

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare R2 Credentials (S3 Compatible Storage)
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Supabase Lead Webhook Integration
SUPABASE_WEBHOOK_URL=https://your_supabase_project.supabase.co/functions/v1/receive-lead-gardiano
SUPABASE_WEBHOOK_SECRET=your_webhook_secret_here

# Admin VSL Dashboard Password
ADMIN_PASSWORD=your_admin_password_here

# CTA Button Delay in milliseconds (3 minutes 5 seconds = 185000ms)
CTA_DELAY_MS=185000
